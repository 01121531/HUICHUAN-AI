# File path: /etc/systemd/system/huichuan.service
# sudo systemctl daemon-reload
# sudo systemctl start huichuan
# sudo systemctl enable huichuan
# sudo systemctl status huichuan
[Unit]
Description=HUICHUAN Service
After=network.target

[Service]
User=ubuntu  # 娉ㄦ剰淇敼鐢ㄦ埛鍚?
WorkingDirectory=/path/to/huichuan  # 娉ㄦ剰淇敼璺緞
ExecStart=/path/to/huichuan/huichuan --port 3000 --log-dir /path/to/huichuan/logs  # 娉ㄦ剰淇敼璺緞鍜岀鍙ｅ彿
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
