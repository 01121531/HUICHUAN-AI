# File path: /etc/systemd/system/huichuan.service
# sudo systemctl daemon-reload
# sudo systemctl start huichuan
# sudo systemctl enable huichuan
# sudo systemctl status huichuan
[Unit]
Description=HUICHUAN Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/path/to/huichuan
ExecStart=/path/to/huichuan/huichuan --port 3000 --log-dir /path/to/huichuan/logs
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
