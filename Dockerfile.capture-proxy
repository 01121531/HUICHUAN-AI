FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /dataset-capture-proxy ./cmd/dataset-capture-proxy

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && adduser -D -H -u 10001 capture \
    && mkdir -p /data \
    && chown capture:capture /data
COPY --from=builder /dataset-capture-proxy /usr/local/bin/dataset-capture-proxy
USER capture
WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["dataset-capture-proxy"]
